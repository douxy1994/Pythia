<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythia.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pythia.Controls"
    xmlns:models="using:Pythia.Models">
    <Grid Padding="{StaticResource PythiaPagePadding}" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="历史记录" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="查找、收藏与复用过去的翻译" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="导出历史记录" Click="Export_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="save" /><TextBlock Text="导出" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="清空全部历史记录" Click="ClearAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="delete" /><TextBlock Text="清空" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索原文、译文或翻译服务" TextChanged="SearchBox_TextChanged" />
            <ToggleButton x:Name="FavoritesOnlyButton" Grid.Column="1" Click="FavoritesOnly_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="star" /><TextBlock Text="仅收藏" /></StackPanel>
            </ToggleButton>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <controls:SvgIcon Icon="history" Width="24" Height="24" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="还没有符合条件的历史记录" />
            </StackPanel>
            <ListView x:Name="HistoryList" ItemsSource="{x:Bind FilteredHistory}" SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryRecord">
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ServiceDisplayName}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind CreatedDisplay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="载入到翻译首页" AutomationProperties.Name="载入历史记录继续翻译" Tag="{x:Bind}" Click="Load_Click"><controls:SvgIcon Icon="arrow-right" /></Button>
                                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏或取消收藏历史记录" Tag="{x:Bind}" Click="Favorite_Click"><controls:SvgIcon Icon="{x:Bind FavoriteIcon, Mode=OneWay}" /></Button>
                                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="复制译文" AutomationProperties.Name="复制历史译文" Tag="{x:Bind}" Click="Copy_Click"><controls:SvgIcon Icon="copy" /></Button>
                                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="删除" AutomationProperties.Name="删除历史记录" Tag="{x:Bind}" Click="Delete_Click"><controls:SvgIcon Icon="delete" /></Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" Text="{x:Bind SourceText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" FontSize="16" IsTextSelectionEnabled="True" Text="{x:Bind TranslatedText}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <TextBlock x:Name="CountText" Grid.Row="3" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Page>
