<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pythia.Pages.PluginSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="PluginPicker"
                AutomationProperties.AutomationId="InstalledPluginPicker"
                AutomationProperties.Name="已安装翻译插件"
                DisplayMemberPath="Name"
                Header="已安装翻译插件"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Plugins}"
                SelectionChanged="PluginPicker_SelectionChanged" />
            <StackPanel Grid.Column="1" Margin="0,20,0,0" Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="刷新插件列表" ToolTipService.ToolTip="刷新插件列表" Click="Refresh_Click">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="打开插件目录" ToolTipService.ToolTip="打开插件目录" Click="OpenFolder_Click">
                    <SymbolIcon Symbol="OpenLocal" />
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" CornerRadius="10" AutomationProperties.Name="安装翻译插件" Click="Install_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Add" /><TextBlock Text="安装插件" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="EmptyPluginInfo"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Title="没有已安装的翻译插件"
            Message="点击“安装插件”选择 .pythia 插件包。" />

        <StackPanel x:Name="SelectedPluginPanel" Spacing="12" Visibility="Collapsed">
            <Border Style="{StaticResource PythiaCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="{StaticResource PythiaCardCornerRadius}">
                        <Grid>
                            <Image x:Name="PluginIconImage" Margin="8" Stretch="Uniform" />
                            <Image x:Name="PluginFallbackImage" Margin="8" Source="/Assets/AppIcon.png" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PluginNameText" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="PluginVersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="PluginDescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PluginMetadataText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PluginPathText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                        <TextBlock x:Name="PluginEnabledText" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <Button x:Name="TogglePluginButton" MinWidth="88" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="启用或停用当前插件" Click="TogglePlugin_Click" />
                        <Button MinWidth="88" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="卸载当前插件" Click="Remove_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Delete" /><TextBlock Text="卸载" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PythiaCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="插件配置" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="配置项由插件清单提供；密钥保存到 Windows Credential Manager。" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ConfigurationFieldsPanel" Spacing="10" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" CornerRadius="10" AutomationProperties.Name="保存当前插件配置" Click="SaveConfiguration_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Save" /><TextBlock Text="保存插件配置" /></StackPanel>
                        </Button>
                        <Button x:Name="TestPluginButton" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="测试当前插件连通性" Click="TestConnection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Play" /><TextBlock Text="测试连通性" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <InfoBar x:Name="PluginStatusInfo" IsClosable="True" IsOpen="False" Title="插件状态" />
    </StackPanel>
</UserControl>
