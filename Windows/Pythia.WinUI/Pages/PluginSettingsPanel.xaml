<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pythia.Pages.PluginSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pythia.Controls"
    xmlns:models="using:Pythia.Models">

    <StackPanel Spacing="16">
        <Grid x:Name="PluginStatusHost" Visibility="Collapsed">
            <InfoBar
                x:Name="PluginStatusInfo"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="插件状态" />
            <Button
                x:Name="PluginStatusCloseButton"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource PythiaStatusCloseButtonStyle}"
                AutomationProperties.Name="关闭插件状态提示"
                ToolTipService.ToolTip="关闭提示"
                Click="PluginStatusClose_Click">
                <Grid Width="20" Height="20">
                    <controls:CountdownRing x:Name="PluginStatusCountdownRing" Width="22" Height="22" RingBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" IsHitTestVisible="False" />
                    <controls:SvgIcon Icon="dismiss" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="安装插件" />
            <TextBlock Style="{StaticResource PythiaSecondaryTextStyle}" Text="支持 .pythia 和 .potext 格式；安装后插件会出现在下面的二级设置列表中。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource PythiaAccentButtonStyle}" AutomationProperties.Name="安装翻译插件" Click="Install_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="add" /><TextBlock Text="安装插件" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="打开插件目录" ToolTipService.ToolTip="打开插件目录" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="folder-open" /><TextBlock Text="打开插件目录" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="打开插件开发指南" ToolTipService.ToolTip="打开插件开发指南" Click="OpenGuide_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="document" /><TextBlock Text="插件开发指南" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="查看现有插件" ToolTipService.ToolTip="在 GitHub 查看现有插件" Click="OpenExistingPlugins_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="puzzle" /><TextBlock Text="现有插件" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="刷新插件列表" ToolTipService.ToolTip="刷新插件列表" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-sync" /><TextBlock Text="刷新列表" /></StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <InfoBar
            x:Name="EmptyPluginInfo"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Title="没有已安装的翻译插件"
            Message="点击“安装插件”选择 .pythia 插件包。" />

        <InfoBar
            x:Name="InvalidPluginInfo"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="有插件未载入"
            Message="" />

        <Border x:Name="PluginOrderCard" Style="{StaticResource PythiaCardStyle}">
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="已安装插件" />
                    <TextBlock Style="{StaticResource PythiaSecondaryTextStyle}" Text="点击左侧展开二级设置；拖动插件可以调整首页结果卡顺序，启用状态与顺序会立即保存。" />
                </StackPanel>
                <ListView
                    x:Name="PluginOrderList"
                    AutomationProperties.AutomationId="PluginServiceOrder"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind OrderedPlugins}"
                    MaxHeight="520"
                    ReorderMode="Enabled"
                    SelectionMode="None"
                    DragItemsCompleted="PluginOrderList_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginInfo">
                            <Expander Tag="{x:Bind}" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="PluginExpander_Expanding" Collapsed="PluginExpander_Collapsed">
                                <Expander.Header>
                                    <Grid FlowDirection="LeftToRight" HorizontalAlignment="Stretch" Padding="4,7" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <controls:SvgIcon Icon="puzzle" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                            <TextBlock Style="{StaticResource PythiaSecondaryTextStyle}" FontSize="12" Text="{x:Bind VersionDisplay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PythiaSecondaryTextStyle}" Text="{x:Bind EnabledDisplay, Mode=OneWay}" />
                                    </Grid>
                                </Expander.Header>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <ContentControl x:Name="SelectedPluginHost" Visibility="Collapsed">
        <StackPanel x:Name="SelectedPluginPanel" FlowDirection="LeftToRight" Spacing="12" Visibility="Collapsed">
            <Border Style="{StaticResource PythiaCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="{StaticResource PythiaCardCornerRadius}">
                        <Grid>
                            <Image x:Name="PluginIconImage" Margin="8" Stretch="Uniform" />
                            <Image x:Name="PluginFallbackImage" Margin="8" Source="/Assets/AppIcon.png" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PluginNameText" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="PluginVersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="PluginDescriptionText" Style="{StaticResource PythiaSecondaryTextStyle}" />
                        <TextBlock x:Name="PluginMetadataText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PluginPathText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="PluginConversionText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="124" HorizontalAlignment="Right" Spacing="6">
                        <ToggleSwitch x:Name="PluginEnabledSwitch" Width="124" HorizontalAlignment="Stretch" Header="启用插件" OnContent="已启用" OffContent="已停用" AutomationProperties.Name="启用或停用当前插件" Toggled="PluginEnabledSwitch_Toggled" />
                        <Button Width="124" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="重命名当前插件" Click="Rename_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="edit" /><TextBlock Text="改名" /></StackPanel>
                        </Button>
                        <Button x:Name="ReconvertButton" Width="124" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="重新转换当前插件" Click="Reconvert_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="arrow-sync" /><TextBlock Text="重新转换" /></StackPanel>
                        </Button>
                        <Button Width="124" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="卸载当前插件" Click="Remove_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="delete" /><TextBlock Text="卸载" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PythiaCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="插件配置" />
                        <TextBlock Style="{StaticResource PythiaSecondaryTextStyle}" Text="配置项由插件清单提供；密钥保存到 Windows Credential Manager。" />
                    </StackPanel>
                    <StackPanel x:Name="ConfigurationFieldsPanel" Spacing="10" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" CornerRadius="10" AutomationProperties.Name="保存当前插件配置" Click="SaveConfiguration_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="save" /><TextBlock Text="保存插件配置" /></StackPanel>
                        </Button>
                        <Button x:Name="TestPluginButton" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="测试当前插件连通性" Click="TestConnection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="play" /><TextBlock Text="测试连通性" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ContentControl>

    </StackPanel>
</UserControl>
