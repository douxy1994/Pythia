<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Pythia.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="20,16,24,20" ColumnSpacing="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

        <ListView x:Name="CategoryList" Grid.Row="1" SelectionChanged="CategoryList_SelectionChanged" SelectionMode="Single">
            <ListViewItem IsSelected="True" Tag="general"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE713;" /><TextBlock Text="通用" /></StackPanel></ListViewItem>
            <ListViewItem Tag="services"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE774;" /><TextBlock Text="翻译服务" /></StackPanel></ListViewItem>
            <ListViewItem Tag="plugins"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xEA86;" /><TextBlock Text="插件" /></StackPanel></ListViewItem>
            <ListViewItem Tag="ocr"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE91B;" /><TextBlock Text="OCR" /></StackPanel></ListViewItem>
            <ListViewItem Tag="shortcuts"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE765;" /><TextBlock Text="快捷键" /></StackPanel></ListViewItem>
            <ListViewItem Tag="sync"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE753;" /><TextBlock Text="备份与同步" /></StackPanel></ListViewItem>
            <ListViewItem Tag="window"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE8A7;" /><TextBlock Text="窗口" /></StackPanel></ListViewItem>
            <ListViewItem Tag="about"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE946;" /><TextBlock Text="关于与更新" /></StackPanel></ListViewItem>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Padding="0,0,8,10">
                    <StackPanel x:Name="GeneralSection" Tag="general" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="通用" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="应用主题" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="跟随 Windows，或固定浅色/深色" TextWrapping="Wrap" /></StackPanel>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟随系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox>
                                </Grid>
                                <ToggleSwitch x:Name="SaveHistorySwitch" Header="保存翻译历史" OnContent="开启" OffContent="关闭" />
                                <ToggleSwitch x:Name="LaunchAtStartupSwitch" Header="登录 Windows 后自动启动" OnContent="开启" OffContent="关闭" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ServicesSection" Tag="services" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="翻译服务" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="凭据安全">
                            <TextBlock Text="API Key 与密钥保存在 Windows Credential Manager，不会写入普通配置文件。" TextWrapping="Wrap" />
                        </InfoBar>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="GoogleSwitch" Header="Google 翻译" OnContent="启用" OffContent="停用" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="无需 API Key，适合日常快速翻译。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="BaiduSwitch" Header="百度翻译" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BaiduAppIdBox" Header="AppID" PlaceholderText="留空则保留已保存值" />
                                    <PasswordBox x:Name="BaiduSecretBox" Grid.Column="1" Header="密钥" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="YoudaoSwitch" Header="有道翻译" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="YoudaoAppKeyBox" Header="AppKey" PlaceholderText="留空则保留已保存值" />
                                    <PasswordBox x:Name="YoudaoSecretBox" Grid.Column="1" Header="密钥" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="OpenAiSwitch" Header="OpenAI 兼容服务" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="OpenAiNameBox" Header="显示名称" />
                                    <TextBox x:Name="OpenAiModelBox" Grid.Column="1" Header="模型" />
                                </Grid>
                                <TextBox x:Name="OpenAiUrlBox" Header="API 基础地址" PlaceholderText="https://api.openai.com/v1" />
                                <PasswordBox x:Name="OpenAiKeyBox" Header="API Key" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="DeepLSwitch" Header="DeepL" OnContent="启用" OffContent="停用" />
                                <TextBox x:Name="DeepLUrlBox" Header="API 基础地址" />
                                <PasswordBox x:Name="DeepLKeyBox" Header="API Key" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="LibreSwitch" Header="LibreTranslate" OnContent="启用" OffContent="停用" />
                                <TextBox x:Name="LibreUrlBox" Header="服务地址" />
                                <PasswordBox x:Name="LibreKeyBox" Header="API Key（可选）" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PluginsSection" Tag="plugins" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="插件" />
                        <Border Style="{StaticResource PythiaCardStyle}"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Pythia 翻译插件" /><TextBlock Text="在侧栏“插件”页面安装、查看或卸载 .pythia 插件。插件目录与旧 Windows 版保持一致。" TextWrapping="Wrap" /><TextBlock x:Name="PluginPathText" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="OcrSection" Tag="ocr" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OCR" />
                        <Border Style="{StaticResource PythiaCardStyle}"><StackPanel Spacing="14"><ToggleSwitch x:Name="OcrAutoTranslateSwitch" Header="识别完成后自动翻译" OnContent="开启" OffContent="关闭" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="使用 Windows 本机 OCR 语言包识别 PNG、JPEG、BMP 与 TIFF 图片。" TextWrapping="Wrap" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ShortcutsSection" Tag="shortcuts" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="快捷键" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="ShowWindowHotkeyBox" Header="显示/隐藏窗口" />
                                <TextBox x:Name="SelectionHotkeyBox" Header="划词翻译" />
                                <TextBox x:Name="ScreenshotTranslateHotkeyBox" Header="截图翻译" />
                                <TextBox x:Name="ScreenshotOcrHotkeyBox" Header="截图 OCR" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="格式示例：Ctrl+Alt+P。保存后会重新注册全局快捷键。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SyncSection" Tag="sync" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="备份与同步" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="WebDavUrlBox" Header="WebDAV 地址" PlaceholderText="https://example.com/dav/Pythia/" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="WebDavUserBox" Header="用户名" />
                                    <PasswordBox x:Name="WebDavPasswordBox" Grid.Column="1" Header="密码" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                                <ToggleSwitch x:Name="WebDavAutoSyncSwitch" Header="自动同步翻译历史" OnContent="开启" OffContent="关闭" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="SyncIntervalBox" Header="同步间隔" Minimum="1" Maximum="168" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="SyncUnitBox" Grid.Column="1" Header="单位" HorizontalAlignment="Stretch"><ComboBoxItem Content="分钟" Tag="minute" /><ComboBoxItem Content="小时" Tag="hour" /><ComboBoxItem Content="天" Tag="day" /></ComboBox>
                                </Grid>
                                <Button HorizontalAlignment="Left" Style="{StaticResource PythiaToolbarButtonStyle}" Click="TestWebDav_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE73E;" /><TextBlock Text="测试连接" /></StackPanel></Button>
                                <TextBlock x:Name="WebDavStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WindowSection" Tag="window" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="窗口" />
                        <Border Style="{StaticResource PythiaCardStyle}"><StackPanel Spacing="14"><ToggleSwitch x:Name="AlwaysOnTopSwitch" Header="窗口始终置顶" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭时最小化到托盘" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="HideOnBlurSwitch" Header="失去焦点时隐藏窗口" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="NotificationsSwitch" Header="显示系统通知" OnContent="开启" OffContent="关闭" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Tag="about" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="关于与更新" />
                        <Border Style="{StaticResource PythiaCardStyle}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="72" Height="72" Source="/Assets/AppIcon.png" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock FontSize="22" FontWeight="SemiBold" Text="Pythia" /><TextBlock Text="Windows 原生版 · WinUI 3 · C# 14 · .NET 10" /><HyperlinkButton Padding="0" Content="检查 GitHub 更新" NavigateUri="https://github.com/douxy1994/Pythia/releases" /></StackPanel></Grid></Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Padding="0,10,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" /><TextBlock Text="保存设置" /></StackPanel></Button></Grid>
        </Grid>
    </Grid>
</Page>
