<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Pythia.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Pythia.Controls" xmlns:pages="using:Pythia.Pages">
    <Grid Padding="20,16,24,20" ColumnSpacing="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

        <ListView x:Name="CategoryList" Grid.Row="1" SelectionChanged="CategoryList_SelectionChanged" SelectionMode="Single">
            <ListViewItem IsSelected="True" Tag="general"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="settings" /><TextBlock Text="通用" /></StackPanel></ListViewItem>
            <ListViewItem Tag="services"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="globe" /><TextBlock Text="翻译服务" /></StackPanel></ListViewItem>
            <ListViewItem Tag="plugins"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="puzzle" /><TextBlock Text="插件" /></StackPanel></ListViewItem>
            <ListViewItem Tag="ocr"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="scan-text" /><TextBlock Text="OCR" /></StackPanel></ListViewItem>
            <ListViewItem Tag="shortcuts"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="keyboard" /><TextBlock Text="快捷键" /></StackPanel></ListViewItem>
            <ListViewItem Tag="sync"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="folder-sync" /><TextBlock Text="备份与同步" /></StackPanel></ListViewItem>
            <ListViewItem Tag="window"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="window" /><TextBlock Text="窗口" /></StackPanel></ListViewItem>
            <ListViewItem Tag="about"><StackPanel Orientation="Horizontal" Spacing="11"><controls:SvgIcon Icon="info" /><TextBlock Text="关于与更新" /></StackPanel></ListViewItem>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="SettingsScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Padding="0,0,8,20">
                    <StackPanel x:Name="GeneralSection" Tag="general" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="通用" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="应用主题" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="跟随 Windows，或固定浅色/深色" TextWrapping="Wrap" /></StackPanel>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="跟随系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox>
                                </Grid>
                                <ToggleSwitch x:Name="SaveHistorySwitch" Header="保存翻译历史" OnContent="开启" OffContent="关闭" />
                                <ToggleSwitch x:Name="CompactTranslationWindowSwitch" Header="划词翻译或截图 OCR 翻译时默认打开简约窗口" OnContent="开启" OffContent="关闭" />
                                <StackPanel Spacing="4">
                                    <ToggleSwitch x:Name="FloatingSelectionButtonSwitch" Header="实验功能：选中文字后显示悬浮翻译按钮" OnContent="开启" OffContent="关闭" />
                                    <TextBlock Margin="0,0,0,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="默认关闭。支持 Word、PDF、网页和常见聊天软件；点击小型 Pythia 图标后读取选区并打开简约窗口。" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LaunchAtStartupSwitch" Header="登录 Windows 后自动启动" OnContent="开启" OffContent="关闭" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ServicesSection" Tag="services" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="翻译服务" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="凭据安全">
                            <TextBlock Text="API Key 与密钥保存在 Windows Credential Manager，不会写入普通配置文件。" TextWrapping="Wrap" />
                        </InfoBar>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="OpenAiSwitch" Header="大模型翻译服务" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="OpenAiNameBox" Header="显示名称" />
                                    <TextBox x:Name="OpenAiModelBox" Grid.Column="1" Header="模型" />
                                </Grid>
                                <ComboBox x:Name="OpenAiApiBox" Header="接口类型" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="OpenAI Chat Completions" Tag="openai" />
                                    <ComboBoxItem Content="Anthropic Messages" Tag="anthropic" />
                                </ComboBox>
                                <TextBox x:Name="OpenAiUrlBox" Header="API 基础地址" PlaceholderText="https://api.openai.com/v1" />
                                <PasswordBox x:Name="OpenAiKeyBox" Header="API Key" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="GoogleSwitch" Header="Google 翻译" OnContent="启用" OffContent="停用" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="无需 API Key，适合日常快速翻译。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="BaiduSwitch" Header="百度翻译" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BaiduAppIdBox" Header="AppID" PlaceholderText="留空则保留已保存值" />
                                    <PasswordBox x:Name="BaiduSecretBox" Grid.Column="1" Header="密钥" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="YoudaoSwitch" Header="有道翻译" OnContent="启用" OffContent="停用" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="YoudaoAppKeyBox" Header="AppKey" PlaceholderText="留空则保留已保存值" />
                                    <PasswordBox x:Name="YoudaoSecretBox" Grid.Column="1" Header="密钥" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="DeepLSwitch" Header="DeepL" OnContent="启用" OffContent="停用" />
                                <TextBox x:Name="DeepLUrlBox" Header="API 基础地址" />
                                <PasswordBox x:Name="DeepLKeyBox" Header="API Key" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <ToggleSwitch x:Name="LibreSwitch" Header="LibreTranslate" OnContent="启用" OffContent="停用" />
                                <TextBox x:Name="LibreUrlBox" Header="服务地址" />
                                <PasswordBox x:Name="LibreKeyBox" Header="API Key（可选）" PlaceholderText="留空则保留已保存值" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PluginsSection" Tag="plugins" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="插件" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="安装、配置和排序只影响已启用的翻译服务；插件密钥始终保存到 Windows Credential Manager。" TextWrapping="Wrap" />
                        <pages:PluginSettingsPanel />
                    </StackPanel>

                    <StackPanel x:Name="OcrSection" Tag="ocr" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OCR" />
                        <Border Style="{StaticResource PythiaCardStyle}"><StackPanel Spacing="14"><ToggleSwitch x:Name="OcrAutoTranslateSwitch" Header="识别完成后自动翻译" OnContent="开启" OffContent="关闭" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="使用 Windows 本机 OCR 语言包识别 PNG、JPEG、BMP 与 TIFF 图片。" TextWrapping="Wrap" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ShortcutsSection" Tag="shortcuts" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="快捷键" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="ShowWindowHotkeyBox" Header="显示/隐藏窗口" IsReadOnly="True" PlaceholderText="单击后按组合键" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <TextBox x:Name="SelectionHotkeyBox" Header="划词翻译" IsReadOnly="True" PlaceholderText="单击后按组合键" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <TextBox x:Name="ScreenshotTranslateHotkeyBox" Header="截图翻译" IsReadOnly="True" PlaceholderText="单击后按组合键" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <TextBox x:Name="ScreenshotOcrHotkeyBox" Header="截图 OCR" IsReadOnly="True" PlaceholderText="单击后按组合键" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="单击输入框后直接按下组合键。保存时会先验证冲突；注册失败会原子恢复原快捷键。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SyncSection" Tag="sync" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="备份与同步" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="WebDavUrlBox" Header="WebDAV 地址" PlaceholderText="https://example.com/dav/Pythia/" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="WebDavUserBox" Header="用户名" />
                                    <PasswordBox x:Name="WebDavPasswordBox" Grid.Column="1" Header="密码" PlaceholderText="留空则保留已保存值" />
                                </Grid>
                                <ToggleSwitch x:Name="WebDavAutoSyncSwitch" Header="自动同步翻译历史" OnContent="开启" OffContent="关闭" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="SyncIntervalBox" Header="同步间隔" Minimum="1" Maximum="168" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Name="SyncUnitBox" Grid.Column="1" Header="单位" HorizontalAlignment="Stretch"><ComboBoxItem Content="分钟" Tag="minute" /><ComboBoxItem Content="小时" Tag="hour" /><ComboBoxItem Content="天" Tag="day" /><ComboBoxItem Content="周" Tag="week" /></ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="测试 WebDAV 连接" Click="TestWebDav_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="link" /><TextBlock Text="测试连接" /></StackPanel></Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="立即同步历史" Click="SyncWebDav_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-sync" /><TextBlock Text="立即同步历史" /></StackPanel></Button>
                                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="上传便携备份" Click="UploadWebDavBackup_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-upload" /><TextBlock Text="上传便携备份" /></StackPanel></Button>
                                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="恢复远程备份" Click="RestoreWebDavBackup_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-download" /><TextBlock Text="恢复远程备份" /></StackPanel></Button>
                                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="导出本地备份" Click="ExportLocalBackup_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="save" /><TextBlock Text="导出本地备份" /></StackPanel></Button>
                                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="导入本地备份" Click="ImportLocalBackup_Click"><StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="folder-open" /><TextBlock Text="导入本地备份" /></StackPanel></Button>
                                </Grid>
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="便携备份包含设置与完整历史，但不会导出密码、API 密钥或其他凭据。同步前会自动保存本地历史快照。" TextWrapping="Wrap" />
                                <TextBlock x:Name="WebDavStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WindowSection" Tag="window" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="窗口" />
                        <Border Style="{StaticResource PythiaCardStyle}"><StackPanel Spacing="14"><ToggleSwitch x:Name="AlwaysOnTopSwitch" Header="窗口始终置顶" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭时最小化到托盘" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="HideOnBlurSwitch" Header="失去焦点时隐藏窗口" OnContent="开启" OffContent="关闭" /><ToggleSwitch x:Name="NotificationsSwitch" Header="显示系统通知" OnContent="开启" OffContent="关闭" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Tag="about" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="关于" />
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="720" Spacing="7">
                                <Image Width="132" Height="132" HorizontalAlignment="Center" Source="/Assets/AppIcon.png" Stretch="Uniform" />
                                <TextBlock HorizontalAlignment="Center" FontSize="36" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Pythia" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正式版本" />
                                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· Windows x64" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" MaxWidth="620" TextAlignment="Center" Style="{StaticResource PythiaSecondaryTextStyle}" Text="本地优先的多服务桌面翻译：划词、输入、截图翻译，多个翻译服务并排作答。" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="GitHubButton" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="打开 Pythia GitHub" Click="OpenGitHub_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7"><Image Width="16" Height="16" Stretch="Uniform"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/GitHubMark.svg" /></Image.Source></Image><TextBlock Text="GitHub" /></StackPanel>
                                    </Button>
                                    <Button x:Name="CheckUpdateButton" Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="检查应用更新" Click="CheckUpdate_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-sync" /><TextBlock Text="检查更新" /></StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="最近版本更新" />
                                <TextBlock x:Name="LatestNotesText" Style="{StaticResource PythiaSecondaryTextStyle}" TextWrapping="Wrap" />
                                <Border x:Name="UpdateCard" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="UpdateVersionText" FontWeight="SemiBold" />
                                        <TextBlock x:Name="UpdateNotesText" Style="{StaticResource PythiaSecondaryTextStyle}" MaxLines="8" TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="UpdateButton" HorizontalAlignment="Left" Visibility="Collapsed" Style="{StaticResource PythiaAccentButtonStyle}" AutomationProperties.Name="下载并安装更新" Click="InstallUpdate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><controls:SvgIcon Icon="arrow-download" /><TextBlock Text="下载并安装更新" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="关于本软件" />
                                <TextBlock Style="{StaticResource PythiaSecondaryTextStyle}" Text="Pythia 是一款本地优先的桌面翻译工具。一个快捷键即可从划词、输入或截图中取词，让 Google、DeepL、百度、有道、OpenAI、LibreTranslate 与 .pythia 插件并排作答；历史记录可通过 WebDAV 在 macOS 与 Windows 之间同步，API Key 只保存于本机凭据中。" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="CheckUpdateOnStartupSwitch" Header="启动时自动检查更新" OnContent="开启" OffContent="关闭" />
                                <TextBlock x:Name="UpdateStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="本地优先 · 原生 Windows · 多服务翻译" />
                                <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="© 2026 Pythia Contributors · AGPL-3.0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Padding="0,12,8,2"><TextBlock x:Name="SaveStatusText" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="设置会自动保存" TextWrapping="Wrap" /></Grid>
        </Grid>
    </Grid>
</Page>
