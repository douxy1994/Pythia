<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Pythia.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PythiaPagePadding}" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="关于 Pythia" />
            <Border Style="{StaticResource PythiaCardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Width="96" Height="96" Source="/Assets/AppIcon.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Pythia" />
                        <TextBlock FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows 原生版 · WinUI 3 · C# 14 · .NET 10" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource PythiaCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="翻译，贴近 Windows" />
                    <TextBlock LineHeight="24" Text="使用 Windows App SDK 的 Fluent Design、Mica 材质和原生系统集成重新构建。设置、历史和凭据格式与旧 Windows 版本兼容。" TextWrapping="Wrap" />
                    <HyperlinkButton Padding="0" Content="GitHub 项目主页" NavigateUri="https://github.com/douxy1994/Pythia" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PythiaCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="数据目录" />
                    <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
