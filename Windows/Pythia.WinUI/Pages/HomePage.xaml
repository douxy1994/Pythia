<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythia.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pythia.Controls"
    xmlns:models="using:Pythia.Models">

    <Grid x:Name="WorkspaceRoot" Padding="32,24,32,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="CompactHeader" Grid.Row="0" Visibility="Collapsed" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource PythiaToolbarButtonStyle}" HorizontalAlignment="Left" MinWidth="150" Padding="18,6" CornerRadius="16" Click="ServiceButton_Click"
                    AutomationProperties.Name="选择并排序翻译服务" ToolTipService.ToolTip="选择并拖动排序翻译服务">
                <TextBlock x:Name="CompactServiceButtonLabel" HorizontalAlignment="Center" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource PythiaCompactIconButtonStyle}" Click="ExpandCompact_Click"
                    AutomationProperties.Name="展开完整翻译窗口" ToolTipService.ToolTip="展开完整窗口">
                <controls:SvgIcon Icon="expand" />
            </Button>
        </Grid>

        <Border x:Name="FullToolbar" Grid.Row="0" Style="{StaticResource PythiaCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceLanguageBox" HorizontalAlignment="Stretch" Header="源语言" SelectionChanged="Language_SelectionChanged" />
                <Button Grid.Column="1" Margin="0,20,0,0" VerticalAlignment="Bottom" Style="{StaticResource PythiaCompactIconButtonStyle}" ToolTipService.ToolTip="交换源语言和目标语言"
                        AutomationProperties.Name="交换源语言和目标语言" Click="SwapLanguages_Click">
                    <controls:SvgIcon x:Name="SwapLanguagesGlyph" Icon="swap" />
                </Button>
                <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" HorizontalAlignment="Stretch" Header="目标语言" SelectionChanged="Language_SelectionChanged" />
                <StackPanel Grid.Column="4" Margin="0,20,0,0" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="SelectionTranslateButton" Style="{StaticResource PythiaCompactIconButtonStyle}" ToolTipService.ToolTip="读取选中文字并翻译" AutomationProperties.Name="划词翻译" Click="SelectionTranslate_Click">
                        <controls:SvgIcon Icon="text-select" />
                    </Button>
                    <Button Style="{StaticResource PythiaCompactIconButtonStyle}" ToolTipService.ToolTip="截取屏幕区域并翻译" AutomationProperties.Name="截图翻译" Click="ScreenshotTranslate_Click">
                        <controls:SvgIcon Icon="crop" />
                    </Button>
                    <Button Style="{StaticResource PythiaCompactIconButtonStyle}" ToolTipService.ToolTip="识别图片中的文字" AutomationProperties.Name="图片文字识别" Click="OcrImage_Click">
                        <controls:SvgIcon Icon="image" />
                    </Button>
                </StackPanel>
                <Button x:Name="TranslateButton" Grid.Column="5" Margin="0,20,0,0" VerticalAlignment="Bottom" Style="{StaticResource PythiaAccentButtonStyle}"
                        AutomationProperties.AutomationId="TranslateButton"
                        CornerRadius="10" AutomationProperties.Name="开始翻译" Click="Translate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:SvgIcon Icon="send" />
                        <TextBlock Text="翻译" />
                    </StackPanel>
                </Button>
                <Button x:Name="PinButton" Grid.Column="6" Margin="0,20,0,0" VerticalAlignment="Bottom" Style="{StaticResource PythiaCompactIconButtonStyle}"
                        AutomationProperties.AutomationId="PinWindowButton"
                        AutomationProperties.Name="窗口置顶" ToolTipService.ToolTip="窗口置顶" Click="PinButton_Click">
                    <controls:SvgIcon x:Name="PinIcon" Icon="pin" />
                </Button>
                <Button x:Name="ServiceButton" Grid.Column="7" Margin="0,20,0,0" VerticalAlignment="Bottom" Style="{StaticResource PythiaToolbarButtonStyle}" Click="ServiceButton_Click"
                        AutomationProperties.AutomationId="ServiceOrderButton"
                        AutomationProperties.Name="选择并排序翻译服务" ToolTipService.ToolTip="选择并拖动排序翻译服务">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:SvgIcon Icon="sort" />
                        <TextBlock x:Name="ServiceButtonLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="SourcePanel" Grid.Row="1" Style="{StaticResource PythiaCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="18,8,10,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PythiaHomeSectionTitleStyle}" Text="原文" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="复制原文" AutomationProperties.Name="复制原文" Click="CopySource_Click"><controls:SvgIcon Icon="copy" /></Button>
                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="粘贴原文" AutomationProperties.Name="粘贴原文" Click="Paste_Click"><controls:SvgIcon Icon="paste" /></Button>
                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="移除换行并合并为单行" AutomationProperties.Name="合并原文为单行" Click="RemoveLineBreaks_Click"><controls:SvgIcon Icon="text-align-left" /></Button>
                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="清空原文和翻译结果" AutomationProperties.Name="清空原文和翻译结果" Click="Clear_Click"><controls:SvgIcon Icon="delete" /></Button>
                    </StackPanel>
                </Grid>
                <TextBox
                    Grid.Row="1"
                    x:Name="SourceTextBox"
                    AutomationProperties.AutomationId="SourceTextBox"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    FontSize="17"
                    Padding="18,8,18,14"
                    PlaceholderText="输入或粘贴原文… Enter 翻译 · Shift + Enter 换行"
                    TextWrapping="Wrap"
                    TextCompositionStarted="SourceTextBox_TextCompositionStarted"
                    TextCompositionEnded="SourceTextBox_TextCompositionEnded"
                    PreviewKeyDown="SourceTextBox_PreviewKeyDown" />
            </Grid>
        </Border>

        <Grid x:Name="ResultsPanel" Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="ResultsTitle" Margin="18,0,0,0" Style="{StaticResource PythiaHomeSectionTitleStyle}" Text="译文" />
            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyResultsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="翻译结果会显示在这里" />
                <ListView x:Name="ResultsList" ItemsSource="{x:Bind Results}" SelectionMode="None" Background="Transparent"
                      AutomationProperties.AutomationId="TranslationResults">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TranslationResult">
                        <Border Style="{StaticResource PythiaCardStyle}" Padding="14,10">
                            <Grid RowSpacing="7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid MinHeight="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                        <controls:SvgIcon Icon="globe" Visibility="{x:Bind BuiltInIconVisibility}" />
                                        <Image Width="18" Height="18" Source="{x:Bind IconSource}" Stretch="Uniform" Visibility="{x:Bind PluginIconVisibility}" />
                                        <Image Width="18" Height="18" Source="/Assets/AppIcon.png" Stretch="Uniform" Visibility="{x:Bind PluginFallbackVisibility}" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ServiceName}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Model}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                        <Button Visibility="{x:Bind CollapseVisibility, Mode=OneWay}" Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="展开或收起结果"
                                                AutomationProperties.Name="展开或收起翻译结果" Tag="{x:Bind}" Click="ToggleResult_Click">
                                            <controls:SvgIcon Icon="{x:Bind ExpandIcon, Mode=OneWay}" />
                                        </Button>
                                        <Button Visibility="{x:Bind RetryVisibility}" Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="重试此服务" AutomationProperties.Name="重试翻译" Tag="{x:Bind}" Click="RetryResult_Click">
                                            <controls:SvgIcon Icon="arrow-sync" />
                                        </Button>
                                        <Button Style="{StaticResource PythiaResultIconButtonStyle}" ToolTipService.ToolTip="复制结果" AutomationProperties.Name="复制翻译结果" Tag="{x:Bind}" Click="CopyResult_Click">
                                            <controls:SvgIcon Icon="copy" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" FontSize="17" IsTextSelectionEnabled="True" Text="{x:Bind DisplayText}" TextWrapping="Wrap"
                                           Visibility="{x:Bind BodyVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid x:Name="FullFooter" Grid.Row="3" Margin="0,4,0,0" ColumnSpacing="12" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind Services.Status.IsBusy, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="StatusText" Text="{x:Bind Services.Status.Message, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="复制全部译文" ToolTipService.ToolTip="复制全部译文" Click="CopyAll_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="copy" /><TextBlock Text="复制全部" /></StackPanel></Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="收藏本次翻译" ToolTipService.ToolTip="收藏本次翻译" Click="FavoriteResults_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="star" /><TextBlock Text="收藏" /></StackPanel></Button>
                <Button Style="{StaticResource PythiaToolbarButtonStyle}" AutomationProperties.Name="朗读首条译文" ToolTipService.ToolTip="朗读首条译文" Click="Speak_Click"><StackPanel Orientation="Horizontal" Spacing="6"><controls:SvgIcon Icon="speaker" /><TextBlock Text="朗读" /></StackPanel></Button>
            </StackPanel>
            <TextBlock x:Name="AppVersionText" Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Page>
