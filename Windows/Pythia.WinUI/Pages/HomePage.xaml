<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythia.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pythia.Models">

    <Grid Padding="{StaticResource PythiaPagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="翻译" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="多引擎翻译、划词与屏幕文字识别" />
            </StackPanel>
            <Button x:Name="ServiceButton" Grid.Column="1" Style="{StaticResource PythiaToolbarButtonStyle}" Click="ServiceButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Globe" />
                    <TextBlock x:Name="ServiceButtonLabel" VerticalAlignment="Center" />
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PythiaCardStyle}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceLanguageBox" HorizontalAlignment="Stretch" Header="源语言" SelectionChanged="Language_SelectionChanged" />
                <Button Grid.Column="1" Width="42" Height="42" Margin="0,20,0,0" ToolTipService.ToolTip="交换语言" Click="SwapLanguages_Click">
                    <SymbolIcon Symbol="Switch" />
                </Button>
                <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" HorizontalAlignment="Stretch" Header="目标语言" SelectionChanged="Language_SelectionChanged" />
                <Button Grid.Column="3" Margin="0,20,0,0" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Click="Translate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Go" />
                        <TextBlock Text="翻译" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PythiaCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="SourceTextBox"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    FontSize="17"
                    Padding="18,14"
                    PlaceholderText="输入或粘贴需要翻译的内容…"
                    TextWrapping="Wrap"
                    KeyDown="SourceTextBox_KeyDown" />
                <Grid Grid.Row="1" Padding="10,7" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="粘贴" Click="Paste_Click"><SymbolIcon Symbol="Paste" /></Button>
                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="移除换行" Click="RemoveLineBreaks_Click"><SymbolIcon Symbol="Trim" /></Button>
                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="清空" Click="Clear_Click"><SymbolIcon Symbol="Delete" /></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="读取当前选中文本并翻译" Click="SelectionTranslate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="TouchPointer" /><TextBlock Text="划词" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="从图片识别文字" Click="OcrImage_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Pictures" /><TextBlock Text="OCR" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyResultsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="翻译结果会显示在这里" />
            <ListView x:Name="ResultsList" ItemsSource="{x:Bind Results}" SelectionMode="None" Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TranslationResult">
                        <Border Style="{StaticResource PythiaCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Globe" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ServiceName}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Model}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Visibility="{x:Bind RetryVisibility}" Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="重试此插件" Tag="{x:Bind}" Click="RetryResult_Click">
                                            <SymbolIcon Symbol="Refresh" />
                                        </Button>
                                        <Button Style="{StaticResource PythiaToolbarButtonStyle}" ToolTipService.ToolTip="复制结果" Tag="{x:Bind}" Click="CopyResult_Click">
                                            <SymbolIcon Symbol="Copy" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" FontSize="17" IsTextSelectionEnabled="True" Text="{x:Bind DisplayText}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Services.Status.IsBusy, Mode=OneWay}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Services.Status.Message, Mode=OneWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Enter 翻译 · Shift + Enter 换行" />
        </Grid>
    </Grid>
</Page>
