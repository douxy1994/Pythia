<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Pythia.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="PythiaCardCornerRadius">16</CornerRadius>
            <Thickness x:Key="PythiaPagePadding">28,20,28,24</Thickness>
            <Thickness x:Key="PythiaCardPadding">20</Thickness>

            <Style x:Key="PythiaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PythiaCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource PythiaCardPadding}" />
            </Style>

            <Style x:Key="PythiaIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="PythiaToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="12,7" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
