<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Pythia.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PythiaTranslateBackgroundBrush" Color="#DCEBFA" />
                    <SolidColorBrush x:Key="PythiaTranslateForegroundBrush" Color="#245A92" />
                    <SolidColorBrush x:Key="PythiaTranslateBorderBrush" Color="#B7D1EC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PythiaTranslateBackgroundBrush" Color="#365F88" />
                    <SolidColorBrush x:Key="PythiaTranslateForegroundBrush" Color="#F3F8FE" />
                    <SolidColorBrush x:Key="PythiaTranslateBorderBrush" Color="#557DA5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PythiaTranslateBackgroundBrush" Color="#DCEBFA" />
                    <SolidColorBrush x:Key="PythiaTranslateForegroundBrush" Color="#245A92" />
                    <SolidColorBrush x:Key="PythiaTranslateBorderBrush" Color="#B7D1EC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="PythiaCardCornerRadius">16</CornerRadius>
            <Thickness x:Key="PythiaPagePadding">32,24,32,24</Thickness>
            <Thickness x:Key="PythiaCardPadding">20</Thickness>


            <Style x:Key="PythiaPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PythiaSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="PythiaHomeSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PythiaTranslateForegroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PythiaSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PythiaCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PythiaCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource PythiaCardPadding}" />
            </Style>

            <Style x:Key="PythiaIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="PythiaToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PythiaAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PythiaToolbarButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource PythiaTranslateBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PythiaTranslateForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PythiaTranslateBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PythiaCompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PythiaToolbarButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PythiaResultIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PythiaStatusCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
